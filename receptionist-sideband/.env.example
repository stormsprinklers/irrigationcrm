# Sideband worker for AI receptionist (Twilio Media Streams ↔ OpenAI Realtime)
PORT=8090
CRM_BASE_URL=https://your-crm.example.com
OPENAI_API_KEY=
# Use owner-assistant for the separate private assistant Railway service.
# Leave unset (or use receptionist) for the customer receptionist service.
SIDEBAND_MODE=receptionist
SIDEBAND_MAX_CONNECTIONS=100
SIDEBAND_MAX_CONNECTIONS_PER_IP=10
# GA Realtime model (do not use retired gpt-4o-realtime-preview + OpenAI-Beta header)
# OPENAI_REALTIME_MODEL=gpt-realtime
